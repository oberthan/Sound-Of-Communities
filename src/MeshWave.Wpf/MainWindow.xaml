<Window x:Class="MeshWave.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MeshWave.Wpf.ViewModels"
        xmlns:views="clr-namespace:MeshWave.Wpf.Views"
        mc:Ignorable="d"
        Title="MeshWave" Height="600" Width="900">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:SetupViewModel}">
            <views:SetupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ManageMusicViewModel}">
            <views:ManageMusicView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlayerViewModel}">
            <views:PlayerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SyncStatusViewModel}">
            <views:SyncStatusView/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundMainBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Background="{StaticResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="MeshWave" FontSize="28" FontWeight="Bold" Margin="20,30" Foreground="{StaticResource AccentBrush}"/>

            <StackPanel Grid.Row="1">
                <Button Content="Library" Command="{Binding NavigateLibraryCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="My Music" Command="{Binding NavigateManageCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="Player" Command="{Binding NavigatePlayerCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="Sync Status" Command="{Binding NavigateSyncCommand}" Style="{StaticResource MenuButtonStyle}"/>
            </StackPanel>

            <Button Grid.Row="2" Content="Settings" Command="{Binding NavigateSetupCommand}" Style="{StaticResource MenuButtonStyle}" Margin="0,0,0,20"/>
        </Grid>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
